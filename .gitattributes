# Auto detect text files and perform LF normalization
* text=auto

# Force LF line endings for all text files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.sqlite binary

# Improve diff output for common file types
*.ts diff=typescript
*.tsx diff=typescript
*.css diff=css
*.md diff=markdown

# Linguist overrides - exclude from language stats
frontend/node_modules/** linguist-vendored
challenges/** linguist-documentation
presentation/** linguist-documentation
*.md linguist-documentation

# Keep package-lock.json from polluting diffs
package-lock.json -diff linguist-generated
frontend/package-lock.json -diff linguist-generated
