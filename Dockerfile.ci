# CI Dockerfile - packages pre-built Next.js standalone app
# Used by GitHub Actions where build happens on runner (not in Docker)

FROM node:20-slim

WORKDIR /app

# Copy standalone output (self-contained, minimal dependencies)
COPY frontend/.next/standalone ./
COPY frontend/.next/static ./.next/static
COPY frontend/public ./public

# Copy database files
COPY frontend/database ./database
COPY frontend/database.sqlite ./database.sqlite
COPY frontend/.env.local ./.env.local

# Setup seed database for persistence
RUN mkdir -p /app/seed && cp database.sqlite /app/seed/database.sqlite

# Startup script
COPY start.sh /usr/local/bin/start.sh
RUN chmod +x /usr/local/bin/start.sh \
    && mkdir -p /app/data \
    && chown -R node:node /app

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000
ENV DATA_DIR=/app/data

VOLUME ["/app/data"]
EXPOSE 3000
USER node

CMD ["node", "server.js"]
